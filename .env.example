# Puerto (Render lo asigna con PORT)
PORT=3000

# PostgreSQL — en Render usa la Internal Database URL del addon
DATABASE_URL=postgresql://user:password@localhost:5432/alahya_quince

# Secreto simple para panel admin de confirmaciones (cámbialo)
ADMIN_SECRET=alahya-admin-cambia-esto

# PIN para publicar deseos en el muro
WISH_PIN=2026

# Clave admin para imprimir deseos y administrar reservas
PRINT_ADMIN_KEY=7874204160

# ——— Alertas de reserva por correo (opcional) ———
# Correo donde quieres recibir cada nueva reserva:
NOTIFY_EMAIL=tu-correo@ejemplo.com
# Opción A — Resend (recomendado en Render): https://resend.com
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Alahya XV <onboarding@resend.dev>
# Opción B — SMTP (Gmail, Outlook, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu@gmail.com
# SMTP_PASS=app-password
# EMAIL_FROM=tu@gmail.com

# Fecha del evento (ISO) — se usa en countdown del servidor y fallback
EVENT_DATE=2026-10-10T17:00:00-04:00
